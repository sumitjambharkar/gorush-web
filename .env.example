# Contact form email delivery (https://resend.com)
# Copy to .env.local for local development; set the same variables on your host for production.
RESEND_API_KEY=
# Where messages are delivered (comma-separate several addresses)
CONTACT_TO_EMAIL=support@gorush.bike
# Sender address on a domain verified in Resend
CONTACT_FROM_EMAIL=GoRush Website <website@gorush.bike>
